JWT_SECRET=change-me-to-a-64-char-random-hex-string
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# Database (libSQL). Pick one:
# - Turso (production / Vercel):
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
# - Local SQLite file (dev / Docker). Equivalent to TURSO_DATABASE_URL=file:./pastebin.db
DB_PATH=./pastebin.db
